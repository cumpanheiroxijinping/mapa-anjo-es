# ===== Server-side secrets (Railway Variables) =====
# Postgres connection — auto-injected by the Railway Postgres service.
DATABASE_URL=

# Resend transactional email API key (services/email-sender.js).
# Create at https://resend.com/api-keys — full access or emails.send scope.
RESEND_API_KEY=

# Resend webhook signing secret (POST /api/resend/webhook, svix headers).
# From the webhook details page in the Resend dashboard (whsec_...).
# If unset, the webhook accepts unsigned posts (dev only).
RESEND_WEBHOOK_SECRET=

# Resend sender identity (fallback when a template has no `From:` header).
# Must be a domain verified in your Resend account.
RESEND_SENDER_EMAIL=soporte@resend.timeoffaith.online
RESEND_SENDER_NAME=Mapa del Ángel de la Guarda

# Optional: override the Resend API base URL (tests/mocking).
# RESEND_API_BASE_URL=https://api.resend.com

# Optional: base URL for self-hosted open/click tracking pixel
# (services/email-sender.js injects it only if set). Leave blank to disable.
# MUST be the PUBLIC url of this app (e.g. https://mapa.timeoffaith.online)
# so email clients can load /t/o/<id> and /t/c/<id>. No Meta/Facebook involved.
TRACKING_BASE_URL=

# Email scheduler / campaign tuning (optional, have sensible defaults).
EMAIL_BATCH_SIZE=50
EMAIL_SEND_INTERVAL_MS=250
EMAIL_SCHEDULER_TICK_MS=15000
EMAIL_BATCH_DELAY_MS=1500

# Protects the CSV export + email dashboard endpoints (ADMIN_TOKEN).
# Used as Bearer token in the dashboard and ?token= on /api/admin/leads.csv.
# Kept as a legacy fallback alongside JWT login (/api/admin/login).
ADMIN_TOKEN=

# JWT auth for the admin panel (/api/admin/login). Generate a long random string.
# If JWT_SECRET is unset, JWT login is unavailable and only ADMIN_TOKEN works.
JWT_SECRET=

# Master admin credentials (fallback when no admin_users rows exist yet).
# Used by /api/admin/login if ADMIN_EMAIL/ADMIN_PASSWORD are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Perfect Pay postback auth token (sent IN THE BODY of the postback request).
PERFECTPAY_TOKEN=d8d4a7ea9cd4940eba25d8546b68f18a

# Hotmart webhook verification token. Set the same value in Hotmart and Railway;
# Hotmart sends it in the X-HOTMART-HOTTOK request header.
HOTMART_TOKEN=

# Optional auth for POST /api/event (frontend funnel events). If unset, open.
EVENT_API_TOKEN=

# Support page URL + email (used in %SUPPORT_URL% and unsubscribe page).
SUPPORT_URL=https://mapa.timeoffaith.online/soporte
SUPPORT_EMAIL=hola@mapa-del-angel.com

# Secret for signing self-hosted unsubscribe tokens (link-tokens.js).
# Generate a long random string. If unset, falls back to ADMIN_TOKEN.
UNSUBSCRIBE_SECRET=

# VTurb API key (spec §14) for authenticated VSL progress events.
# Keep server-side; do NOT expose to the Vite frontend build.
VTURB_API_KEY=1e94f3d0b8b75da34d11e6c6ed7d3f96bf9750ebf7811ebe27b45c1ff7465457

# ===== Funnel config (also exposed to the frontend build as VITE_*) =====
# Final checkout (where the sale happens). YouShop placeholder:
CHECKOUT_URL=https://pay.youshop.co/DS7KII7HJJ5MLP59

# ===== Multi-provider checkout (spec §10) — no code change to switch =====
# Select the active checkout provider. One of: perfectpay, hotmart, vega, zenith.
# The redirector (/checkout-redirect) and email placeholders resolve the
# destination from the provider-specific vars below — switching is instant.
ACTIVE_CHECKOUT_PROVIDER=

# Base public URL for intention-based email routes (/continuar-quiz, /pedido-status,
# /checkout-redirect, ...). Defaults to TRACKING_BASE_URL then DEFAULT_EVENT_SOURCE_URL.
PUBLIC_BASE_URL=

# Main checkout URL(s). Prefer the provider-specific var; MAIN_CHECKOUT_URL is a
# generic fallback. The redirector throws a controlled error (-> /erro) if the
# active provider's URL is missing (no silent fallback to another provider).
MAIN_CHECKOUT_URL=
MAIN_CHECKOUT_URL_PERFECTPAY=
MAIN_CHECKOUT_URL_HOTMART=
MAIN_CHECKOUT_URL_VEGA=
MAIN_CHECKOUT_URL_ZENITH=

# Upsell (up1/up2/up3) checkout URLs per provider. Generic UP*_CHECKOUT_URL is
# the fallback when the provider-specific var is unset.
UP1_CHECKOUT_URL=
UP1_CHECKOUT_URL_PERFECTPAY=
UP1_CHECKOUT_URL_HOTMART=
UP1_CHECKOUT_URL_VEGA=
UP1_CHECKOUT_URL_ZENITH=
UP2_CHECKOUT_URL=
UP2_CHECKOUT_URL_PERFECTPAY=
UP2_CHECKOUT_URL_HOTMART=
UP2_CHECKOUT_URL_VEGA=
UP2_CHECKOUT_URL_ZENITH=
UP3_CHECKOUT_URL=
UP3_CHECKOUT_URL_PERFECTPAY=
UP3_CHECKOUT_URL_HOTMART=
UP3_CHECKOUT_URL_VEGA=
UP3_CHECKOUT_URL_ZENITH=

# Exact second in VSL1 at which the email-capture overlay opens (original = 5:04 = 304s).
EMAIL_CAPTURE_AT_SEC=304

FUNNEL_NAME=angel_guarda

# ===== Vite build-time (set the same values above; Vite bakes them in at build) =====
VITE_CHECKOUT_URL=https://pay.youshop.co/DS7KII7HJJ5MLP59
VITE_EMAIL_CAPTURE_AT_SEC=304
VITE_FUNNEL_NAME=angel_guarda
